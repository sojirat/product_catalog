DB_HOST=sqlserver.example.internal
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=change-me
DB_NAME=product_catalog
DB_SCHEMA=dbo
# Excel hard limit is 1,048,576 rows per worksheet. Oversized sheets are
# omitted from raw XLSX and represented by a blank "use csv" combined sheet.
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
# Set to yes only for development servers with a self-signed certificate.
DB_TRUST_SERVER_CERTIFICATE=no

# Empty BATCH_ID means manual full generate.
BATCH_ID=
TRIGGERED_BY=system
SQL_DIR=product_catalog/sql
SOURCE_PRODUCT_TABLE=PRODUCT_MST
LOAD_BATCH_NAME=MIGRATE_DATA
LOAD_CREATED_BY=system
