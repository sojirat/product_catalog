DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=product_catalog

TYPHOON_API_KEY=your_api_key_here
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
AI_BATCH_SIZE=20
AI_WORKERS=1
AI_BATCH_DELAY=3
AI_MAX_RETRY=3
AI_MIN_CONF=0.50
AI_SCOPE=unmatched
AI_CACHE_PATH=typhoon_cat_cache.json
AI_SERIES_MIN_CONF=0.65
AI_SERIES_CACHE_PATH=typhoon_series_cache.json

# Empty BATCH_ID means manual full generate.
BATCH_ID=1
TRIGGERED_BY=sojirat.s

# SQL files source folder for --install-sql / --all.
SQL_DIR=product_catalog/sql

SOURCE_PRODUCT_TABLE=PRODUCT_MST_20260508
LOAD_BATCH_NAME=MIGRATE_DATA_20260508
LOAD_CREATED_BY=sojirat.s

TEMPLATE_MAPPING_TABLE=template_mapping
EXPORT_OUTPUT_DIR=export
EXCEL_TEMPLATE_DIR=template
